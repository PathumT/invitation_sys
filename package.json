{
  "name": "evently-invitations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-inviteflow --only firestore,storage,auth \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start",
    "test:e2e": "firebase emulators:exec --project demo-inviteflow --only firestore,storage,auth \"playwright test\"",
    "test:responsive": "firebase emulators:exec --project demo-inviteflow --only firestore,storage,auth \"playwright test responsive.e2e.ts\"",
    "test:dashboard": "firebase emulators:exec --project demo-inviteflow --only firestore,storage,auth \"playwright test dashboard.e2e.ts --project chromium\"",
    "i18n:extract": "node scripts/extract-localization.mjs --write",
    "i18n:check": "node scripts/extract-localization.mjs --check"
  },
  "dependencies": {
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.74.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^13.1.0",
    "framer-motion": "^14.6.0",
    "i18next": "^26.5.10",
    "jspdf": "^4.2.1",
    "konva": "^9.3.20",
    "libphonenumber-js": "^1.11.20",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^17.1.8",
    "react-konva": "^19.0.3",
    "react-router-dom": "^7.5.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.24.0",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.29.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
